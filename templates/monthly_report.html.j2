<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>의정부 경전철 월간 분석 보고서 - {{ report_data.period }}</title>
  <!-- 프리미엄 폰트 패밀리 로드 -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700&family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
  
  <style>
    /* CSS 디자인 토큰 정의 - templates/design.md 기준 */
    :root {
      --bg-color: #f8fafc;
      --card-bg: rgba(255, 255, 255, 0.85);
      --card-border: rgba(226, 232, 240, 0.8);
      --text-primary: #0f172a;
      --text-secondary: #64748b;
      --accent-blue: #3b82f6;
      --accent-cyan: #06b6d4;
      --success: #10b981;
      --danger: #ef4444;
      --shadow: 0 8px 32px 0 rgba(148, 163, 184, 0.08);
      --backdrop-blur: blur(12px);
      --header-bg: #0f172a;
      --header-text: #ffffff;
    }

    [data-theme="dark"] {
      --bg-color: #0f172a;
      --card-bg: rgba(30, 41, 59, 0.85);
      --card-border: rgba(51, 65, 85, 0.6);
      --text-primary: #f8fafc;
      --text-secondary: #94a3b8;
      --accent-blue: #60a5fa;
      --accent-cyan: #22d3ee;
      --shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
      --header-bg: #1e293b;
      --header-text: #f8fafc;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', 'Noto Sans KR', sans-serif;
      background-color: var(--bg-color);
      color: var(--text-primary);
      line-height: 1.6;
      padding-bottom: 80px;
      transition: background-color 0.3s, color 0.3s;
    }

    /* 네비게이션 헤더 */
    header {
      background-color: var(--header-bg);
      color: var(--header-text);
      padding: 20px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    header h1 {
      font-family: 'Outfit', sans-serif;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    /* 테마 전환 토글 버튼 */
    .theme-toggle-btn {
      background: transparent;
      border: 1px solid var(--text-secondary);
      color: inherit;
      padding: 8px 16px;
      border-radius: 20px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 500;
      transition: all 0.2s;
    }

    .theme-toggle-btn:hover {
      background-color: var(--accent-blue);
      border-color: var(--accent-blue);
      color: #ffffff;
    }

    /* 전체 레이아웃 컨테이너 */
    .container {
      max-width: 1200px;
      margin: 40px auto;
      padding: 0 20px;
    }

    /* 목차 네비게이션 카드 */
    .toc-card {
      background: var(--card-bg);
      backdrop-filter: var(--backdrop-blur);
      -webkit-backdrop-filter: var(--backdrop-blur);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 24px;
      margin-bottom: 30px;
      box-shadow: var(--shadow);
    }

    .toc-card h2 {
      font-family: 'Outfit', sans-serif;
      font-size: 16px;
      color: var(--text-secondary);
      margin-bottom: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .toc-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
      list-style: none;
    }

    .toc-list a {
      color: var(--text-primary);
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      display: flex;
      align-items: center;
      padding: 8px 12px;
      border-radius: 8px;
      background-color: rgba(148, 163, 184, 0.05);
      transition: all 0.2s;
    }

    .toc-list a:hover {
      background-color: var(--accent-blue);
      color: #ffffff;
      transform: translateY(-1px);
    }

    /* 리포트 메인 헤더 타이틀 */
    .report-title-section {
      text-align: center;
      margin-bottom: 50px;
    }

    .report-title-section h2 {
      font-family: 'Outfit', sans-serif;
      font-size: 40px;
      font-weight: 700;
      color: var(--accent-blue);
      margin-bottom: 8px;
    }

    .report-title-section p {
      color: var(--text-secondary);
      font-size: 16px;
    }

    /* 섹션 레이아웃 */
    .section-card {
      background: var(--card-bg);
      backdrop-filter: var(--backdrop-blur);
      -webkit-backdrop-filter: var(--backdrop-blur);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      padding: 36px;
      margin-bottom: 40px;
      box-shadow: var(--shadow);
      transition: transform 0.2s;
    }

    .section-card:hover {
      transform: translateY(-2px);
    }

    .section-card h3 {
      font-family: 'Outfit', sans-serif;
      font-size: 22px;
      font-weight: 700;
      margin-bottom: 24px;
      padding-bottom: 8px;
      border-bottom: 2px solid var(--accent-blue);
      display: inline-block;
    }

    /* 그리드 메트릭스 카드 (종합 지표용) */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .metric-item {
      background-color: rgba(148, 163, 184, 0.05);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 20px;
      text-align: center;
    }

    .metric-item .label {
      font-size: 13px;
      color: var(--text-secondary);
      margin-bottom: 8px;
      font-weight: 500;
    }

    .metric-item .value {
      font-family: 'Outfit', sans-serif;
      font-size: 28px;
      font-weight: 700;
      color: var(--accent-blue);
    }

    .metric-item .unit {
      font-size: 14px;
      color: var(--text-secondary);
      font-weight: 400;
      margin-left: 2px;
    }

    /* 시각화 및 데이터 비교 그리드 */
    .content-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 30px;
      margin-top: 20px;
    }

    @media (max-width: 900px) {
      .content-grid {
        grid-template-columns: 1fr;
      }
    }

    /* 이미지 및 차트 스타일링 */
    .chart-container {
      background-color: var(--bg-color);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 16px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .chart-container img {
      max-width: 100%;
      height: auto;
      border-radius: 8px;
    }

    /* 테이블 스타일링 */
    .table-container {
      overflow-x: auto;
      width: 100%;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 14px;
    }

    th {
      background-color: rgba(148, 163, 184, 0.1);
      color: var(--text-primary);
      padding: 12px;
      font-weight: 600;
      border-bottom: 2px solid var(--card-border);
    }

    td {
      padding: 12px;
      border-bottom: 1px solid var(--card-border);
      color: var(--text-primary);
    }

    tr:hover td {
      background-color: rgba(148, 163, 184, 0.05);
    }

    /* 경고 및 성공 뱃지 */
    .badge {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
    }

    .badge-success {
      background-color: rgba(16, 185, 129, 0.15);
      color: var(--success);
    }

    .badge-danger {
      background-color: rgba(239, 68, 68, 0.15);
      color: var(--danger);
    }

    .badge-secondary {
      background-color: rgba(100, 116, 139, 0.15);
      color: var(--text-secondary);
    }

    /* 내러티브 텍스트 블록 */
    .narrative-text {
      font-size: 15px;
      color: var(--text-primary);
      line-height: 1.8;
      text-align: justify;
      margin-top: 15px;
    }

    .narrative-list {
      margin-top: 12px;
      margin-left: 20px;
    }

    .narrative-list li {
      margin-bottom: 8px;
      font-size: 14.5px;
    }

    /* PDF 프린트 출력용 스타일 (페이지 잘림 방지 및 레이아웃 개선) */
    @media print {
      body {
        background-color: white !important;
        padding-bottom: 0;
        font-size: 13pt; /* 프린트 가독성을 위해 폰트 크기 미세조정 */
      }
      .container {
        margin: 0 auto;
        padding: 0 15px;
        max-width: none;
      }
      /* 라운드 박스 디자인을 없애고 여백 중심의 문서(Document) 스타일로 변경 */
      .section-card {
        page-break-inside: avoid;
        box-shadow: none !important;
        border: none !important; /* 테두리 제거 */
        background: transparent !important; /* 배경색 제거 */
        padding: 10px 0 !important; /* 좌우 여백을 없애서 테이블이 넉넉하게 들어갈 공간 확보 */
        margin-bottom: 40px !important; /* 섹션 간격 확보 */
      }
      .section-card h3 {
        font-size: 18pt;
        border-bottom: 2px solid var(--text-primary); /* 인쇄용 대비 높은 색상으로 강조 */
        margin-bottom: 20px;
        padding-bottom: 5px;
      }
      /* 표와 차트가 페이지 중간에 잘리지 않도록 보호 */
      .chart-container, .table-container, table, tr, img {
        page-break-inside: avoid;
      }
      /* 테이블 테두리를 깔끔한 실선으로 변경하여 인쇄 최적화 */
      table {
        border: 1px solid var(--card-border);
      }
      th, td {
        border-bottom: 1px solid var(--card-border);
        padding: 12px 8px;
      }
      th {
        background-color: #f8fafc !important; /* 인쇄 시 옅은 회색 배경 유지 */
        -webkit-print-color-adjust: exact;
      }
      /* 네비게이션/토글 버튼 등 인쇄 불필요 요소 숨김 및 타이틀 레이아웃 복원 */
      header {
        position: static !important;
        box-shadow: none;
        border-bottom: 2px solid var(--text-primary);
        padding: 15px 0;
        margin-bottom: 40px;
      }
      header h1 {
        visibility: hidden !important; /* 텍스트(의정부 경전철 월간 HTML 분석 보고서)만 지우고 배경 선은 유지 */
      }
      .theme-toggle-btn, .toc-card {
        display: none !important; 
      }
      /* 대제목 영역: 중앙 정렬, 줄바꿈 방지 및 적절한 하단 여백 (1장 바로 위에 위치하도록) */
      .report-title-section {
        margin: 10px auto 30px auto !important; /* 위아래 여백을 대폭 줄여서 1장과 붙임 */
        text-align: center;
      }
      .report-title-section h2 {
        font-size: 26pt !important; /* 폰트를 살짝 줄여서 문서 제목처럼 단정하게 */
        white-space: nowrap !important;
        margin-bottom: 10px !important;
      }
      .report-title-section p {
        font-size: 13pt !important;
        white-space: nowrap !important;
      }
      /* 특정 장(Section)의 강제 페이지 넘김 설정 */
      #section1 {
        page-break-after: always !important; /* 1번 종합요약 단독 1장 */
      }
      #section3 {
        page-break-after: always !important; /* 2번, 3번이 한 장에 나오고 페이지 넘김 */
      }
      /* 종합 지표 카드 4개를 1줄에 나란히 배치 */
      .metrics-grid {
        display: grid !important;
        grid-template-columns: repeat(4, 1fr) !important; /* 강제 4단 */
        gap: 10px !important;
      }
      .metric-item {
        border: 1px solid var(--card-border);
        background: transparent !important;
        padding: 12px 8px !important; /* 카드 너비를 줄이기 위해 여백 최소화 */
      }
      .metric-item .label {
        font-size: 10pt !important;
        margin-bottom: 4px;
      }
      .metric-item .value {
        font-size: 16pt !important; /* 글씨 크기를 줄여 4개가 들어가도록 조절 */
      }
      .metric-item .unit {
        font-size: 11pt !important;
      }
    }
  </style>
</head>
<body>

  <!-- 상단 네비게이션 헤더 -->
  <header>
    <h1>의정부 경전철 월간 HTML 분석 보고서</h1>
    <button class="theme-toggle-btn" id="themeToggle">다크 모드</button>
  </header>

  <div class="container">
    
    <!-- 리포트 메인 헤더 -->
    <div class="report-title-section">
      <h2>{{ report_data.period_ko }} 분석 리포트</h2>
      <p>작성일: {{ report_data.report_date }} | 수집 기준: 의정부 경전철 승하차 통계</p>
    </div>

    <!-- 목차 네비게이션 카드 -->
    <nav class="toc-card">
      <h2>목차</h2>
      <ul class="toc-list">
        <li><a href="#section1">1. 종합 요약</a></li>
        <li><a href="#section2">2. 데이터 기준 및 품질</a></li>
        <li><a href="#section3">3. 월간 전체 이용현황</a></li>
        <li><a href="#section4">4. 역별 이용현황</a></li>
        <li><a href="#section5">5. 시간대별 이용 패턴</a></li>
        <li><a href="#section6">6. 요일별 이용 패턴</a></li>
        <li><a href="#section7">7. 날씨·행사 연계 검토</a></li>
        <li><a href="#section8">8. 주요 변화 및 특이사항</a></li>
        <li><a href="#section9">9. 운영 관점 시사점</a></li>
        <li><a href="#section10">10. 한계 및 추가 검토사항</a></li>
      </ul>
    </nav>

    <!-- 1. 종합 요약 -->
    <section class="section-card" id="section1">
      <h3>1. 종합 요약</h3>
      <div class="narrative-text">
        {{ report_narrative.executive_summary }}
      </div>
    </section>

    <!-- 2. 데이터 기준 및 품질 점검 -->
    <section class="section-card" id="section2">
      <h3>2. 데이터 기준 및 품질 점검</h3>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>데이터 소스</th>
              <th>검증 항목</th>
              <th>상태</th>
              <th>상세 내용</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>경전철 승하차 현황 CSV</td>
              <td>승객 수 음수값, 결측치, 대상 월 정합성</td>
              <td>
                {% if external_context.ridership_validation.status == 'PASS' %}
                <span class="badge badge-success">PASS</span>
                {% else %}
                <span class="badge badge-danger">WARNING</span>
                {% endif %}
              </td>
              <td>총 {{ external_context.ridership_validation.total_rows }}행 중 {{ external_context.ridership_validation.valid_rows }}행 검증 완료</td>
            </tr>
            <tr>
              <td>의정부시청 행사 HTML</td>
              <td>필수값 유무, 시작-종료 정합성, 중복값</td>
              <td>
                {% if external_context.event_validation.status == 'PASS' %}
                <span class="badge badge-success">PASS</span>
                {% else %}
                <span class="badge badge-secondary">WARNING</span>
                {% endif %}
              </td>
              <td>총 {{ external_context.event_validation.total_events }}건 수집 (정상: {{ external_context.event_validation.valid_events }}건, 확인요망: {{ external_context.event_validation.warning_events }}건)</td>
            </tr>
            <tr>
              <td>Open-Meteo 기상 JSON</td>
              <td>기온 및 강수량 논리적 범위, 데이터 누락</td>
              <td>
                {% if external_context.weather_validation.status == 'PASS' %}
                <span class="badge badge-success">PASS</span>
                {% else %}
                <span class="badge badge-danger">FAIL</span>
                {% endif %}
              </td>
              <td>총 {{ external_context.weather_validation.total_days }}일치 누락 없이 검증 완료</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 3. 월간 전체 이용현황 -->
    <section class="section-card" id="section3">
      <h3>3. 월간 전체 이용현황</h3>
      <div class="metrics-grid">
        <div class="metric-item">
          <div class="label">총 수송 승객수</div>
          <div class="value">{{ "{:,}".format(report_data.total_ridership) }}<span class="unit">명</span></div>
        </div>
        <div class="metric-item">
          <div class="label">하루 평균 승객수</div>
          <div class="value">{{ "{:,}".format(report_data.daily_average_ridership) }}<span class="unit">명</span></div>
        </div>
        <div class="metric-item">
          <div class="label">평일 일평균</div>
          <div class="value">{{ "{:,}".format(report_data.weekday_average) }}<span class="unit">명</span></div>
        </div>
        <div class="metric-item">
          <div class="label">주말/공휴일 일평균</div>
          <div class="value">{{ "{:,}".format(report_data.weekend_average) }}<span class="unit">명</span></div>
        </div>
      </div>
    </section>

    <!-- 4. 역별 이용현황 -->
    <section class="section-card" id="section4">
      <h3>4. 역별 이용현황</h3>
      <div class="content-grid">
        <div class="chart-container">
          <img src="charts/station_rank.png" alt="역별 이용량 순위 차트">
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>순위</th>
                <th>역명</th>
                <th>총 이용량</th>
                <th>점유율</th>
              </tr>
            </thead>
            <tbody>
              {% for item in report_data.top_stations %}
              <tr>
                <td>{{ item.rank }}</td>
                <td><strong>{{ item.station }}</strong></td>
                <td>{{ "{:,}".format(item.total_count) }} 명</td>
                <td>{{ item.share_ratio }}%</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
      <div class="narrative-text">
        {{ report_narrative.station_analysis }}
      </div>
    </section>

    <!-- 5. 시간대별 이용 패턴 -->
    <section class="section-card" id="section5">
      <h3>5. 시간대별 이용 패턴</h3>
      <div class="content-grid">
        <div class="chart-container">
          <img src="charts/hourly_pattern.png" alt="시간대별 패턴 차트">
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>구분</th>
                <th>피크 시간대</th>
                <th>시간대 승객수</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>출근 시간대 피크</td>
                <td><strong>{{ report_data.morning_peak_hour }}시</strong></td>
                <td>{{ "{:,}".format(report_data.morning_peak_count) }} 명</td>
              </tr>
              <tr>
                <td>퇴근 시간대 피크</td>
                <td><strong>{{ report_data.evening_peak_hour }}시</strong></td>
                <td>{{ "{:,}".format(report_data.evening_peak_count) }} 명</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="narrative-text">
        {{ report_narrative.hourly_analysis }}
      </div>
    </section>

    <!-- 6. 요일별 이용 패턴 -->
    <section class="section-card" id="section6">
      <h3>6. 요일별 이용 패턴</h3>
      <div class="content-grid">
        <div class="chart-container">
          <img src="charts/weekday_pattern.png" alt="요일별 패턴 차트">
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>요일</th>
                <th>일평균 승객수</th>
              </tr>
            </thead>
            <tbody>
              {% for wd in report_data.weekday_data %}
              <tr>
                <td>{{ wd.weekday_ko }}요일</td>
                <td>{{ "{:,}".format(wd.average_daily_count) }} 명</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
      <div class="narrative-text">
        {{ report_narrative.weekday_analysis }}
      </div>
    </section>

    <!-- 7. 날씨·행사 연계 검토 -->
    <section class="section-card" id="section7">
      <h3>7. 날씨·행사 연계 검토</h3>
      <div class="content-grid" style="grid-template-columns: 1fr;">
        <div class="chart-container">
          <img src="charts/daily_weather_usage.png" alt="일별 날씨 및 이용객 추이 차트">
        </div>
      </div>
      <div class="narrative-text">
        {{ report_narrative.weather_event_context }}
      </div>
    </section>

    <!-- 8. 주요 변화 및 특이사항 -->
    <section class="section-card" id="section8">
      <h3>8. 주요 변화 및 특이사항</h3>
      <ul class="narrative-list">
        {% for finding in report_narrative.key_findings %}
        <li>{{ finding }}</li>
        {% endfor %}
      </ul>
      {% if report_data.anomalies %}
      <div class="table-container" style="margin-top: 20px;">
        <h4 style="font-size: 14px; margin-bottom: 10px; color: var(--text-secondary);">이탈 변동 일자 리스트</h4>
        <table>
          <thead>
            <tr>
              <th>일자</th>
              <th>일일 승객</th>
              <th>편차율</th>
              <th>이상 유형</th>
              <th>당일 날씨</th>
              <th>연계된 의정부시 주요 행사</th>
            </tr>
          </thead>
          <tbody>
            {% for an in report_data.anomalies %}
            <tr>
              <td>{{ an.date }}</td>
              <td>{{ "{:,}".format(an.total_count) }} 명</td>
              <td>
                {% if an.deviation_percent > 0 %}
                <span style="color: var(--success);">+{{ an.deviation_percent }}%</span>
                {% else %}
                <span style="color: var(--danger);">{{ an.deviation_percent }}%</span>
                {% endif %}
              </td>
              <td>
                {% if an.anomaly_type == '급증' %}
                <span class="badge badge-success">급증</span>
                {% else %}
                <span class="badge badge-danger">급감</span>
                {% endif %}
              </td>
              <td>{{ an.weather_summary }}</td>
              <td>{{ an.matching_events }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
    </section>

    <!-- 9. 운영 관점 시사점 -->
    <section class="section-card" id="section9">
      <h3>9. 운영 관점 시사점</h3>
      <div class="narrative-text">
        {{ report_narrative.operational_notes }}
      </div>
    </section>

    <!-- 10. 한계 및 추가 검토사항 -->
    <section class="section-card" id="section10">
      <h3>10. 한계 및 추가 검토사항</h3>
      <div class="narrative-text">
        {{ report_narrative.limitations }}
      </div>
    </section>

  </div>

  <script>
    // 테마 토글 스크립트
    const themeToggleBtn = document.getElementById('themeToggle');
    
    // 로컬 스토리지에 테마 상태 저장 확인
    const currentTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-theme', currentTheme);
    themeToggleBtn.textContent = currentTheme === 'dark' ? '라이트 모드' : '다크 모드';

    themeToggleBtn.addEventListener('click', () => {
      let theme = document.documentElement.getAttribute('data-theme');
      if (theme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'light');
        localStorage.setItem('theme', 'light');
        themeToggleBtn.textContent = '다크 모드';
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
        themeToggleBtn.textContent = '라이트 모드';
      }
    });
  </script>
</body>
</html>
